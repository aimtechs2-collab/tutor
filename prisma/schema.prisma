generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                 String          @id
  title              String          @default("New conversation")
  createdAt          Float           @map("created_at")
  updatedAt          Float           @map("updated_at")
  compressedSummary  String?         @default("") @map("compressed_summary")
  summaryUpToMsgId   Int?            @default(0) @map("summary_up_to_msg_id")
  preferencesJson    String?         @default("{}") @map("preferences_json")
  messages           Message[]
  turns              Turn[]
  notebookEntries    NotebookEntry[]

  @@index([updatedAt(sort: Desc)], map: "idx_sessions_updated_at")
  @@map("sessions")
}

model Message {
  id              BigInt   @id @default(autoincrement())
  sessionId       String   @map("session_id")
  role            String
  content         String   @default("")
  capability      String?  @default("")
  eventsJson      String?  @default("") @map("events_json")
  attachmentsJson String?  @default("") @map("attachments_json")
  metadataJson    String?  @default("{}") @map("metadata_json")
  createdAt       Float    @map("created_at")
  parentMessageId BigInt?  @map("parent_message_id")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt, id], map: "idx_messages_session_created")
  @@index([sessionId, parentMessageId], map: "idx_messages_parent")
  @@map("messages")
}

model Turn {
  id         String      @id
  sessionId  String      @map("session_id")
  capability String?     @default("")
  status     String      @default("running")
  error      String?     @default("")
  createdAt  Float       @map("created_at")
  updatedAt  Float       @map("updated_at")
  finishedAt Float?      @map("finished_at")
  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events     TurnEvent[]

  @@index([sessionId, updatedAt(sort: Desc)], map: "idx_turns_session_updated")
  @@index([sessionId, status, updatedAt(sort: Desc)], map: "idx_turns_session_status")
  @@map("turns")
}

model TurnEvent {
  id           BigInt @id @default(autoincrement())
  turnId       String @map("turn_id")
  seq          Int
  type         String
  source       String? @default("")
  stage        String? @default("")
  content      String? @default("")
  metadataJson String? @default("") @map("metadata_json")
  timestamp    Float
  createdAt    Float  @map("created_at")
  turn         Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, seq])
  @@index([turnId, seq], map: "idx_turn_events_turn_seq")
  @@map("turn_events")
}

model NotebookEntry {
  id                   BigInt                    @id @default(autoincrement())
  sessionId            String                    @map("session_id")
  turnId               String                    @default("") @map("turn_id")
  questionId           String                    @map("question_id")
  question             String
  questionType         String?                   @default("") @map("question_type")
  optionsJson          String?                   @default("{}") @map("options_json")
  correctAnswer        String?                   @default("") @map("correct_answer")
  explanation          String?                   @default("")
  difficulty           String?                   @default("")
  userAnswer           String?                   @default("") @map("user_answer")
  userAnswerImagesJson String?                   @default("[]") @map("user_answer_images_json")
  isCorrect            Int?                      @default(0) @map("is_correct")
  bookmarked           Int?                      @default(0)
  followupSessionId    String?                   @default("") @map("followup_session_id")
  aiJudgment           String?                   @default("") @map("ai_judgment")
  createdAt            Float                     @map("created_at")
  updatedAt            Float                     @map("updated_at")
  session              Session                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  categories           NotebookEntryCategory[]

  @@unique([sessionId, turnId, questionId])
  @@index([sessionId, createdAt(sort: Desc)], map: "idx_notebook_entries_session")
  @@index([bookmarked, createdAt(sort: Desc)], map: "idx_notebook_entries_bookmarked")
  @@map("notebook_entries")
}

model NotebookCategory {
  id        BigInt                   @id @default(autoincrement())
  name      String                   @unique
  createdAt Float                    @map("created_at")
  entries   NotebookEntryCategory[]

  @@map("notebook_categories")
}

model NotebookEntryCategory {
  entryId    BigInt           @map("entry_id")
  categoryId BigInt           @map("category_id")
  entry      NotebookEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  category   NotebookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([entryId, categoryId])
  @@map("notebook_entry_categories")
}

model AuthUser {
  id               String    @id
  username         String    @unique
  passwordHash     String    @map("password_hash")
  role             String    @default("user")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  disabled         Boolean   @default(false)
  suspendedAt      DateTime? @map("suspended_at")
  suspensionReason String    @default("") @map("suspension_reason")
  banned           Boolean   @default(false)
  banReason        String    @default("") @map("ban_reason")
  adminRole        String?   @map("admin_role")

  @@index([role])
  @@map("auth_users")
}

model AuthSecret {
  name      String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("auth_secrets")
}

model Plan {
  id              String     @id @default(cuid())
  name            String     @unique
  displayName     String     @map("display_name")
  priceMonthly    Float      @default(0) @map("price_monthly")
  priceYearly     Float      @default(0) @map("price_yearly")
  chatMessages    Int        @default(100) @map("chat_messages")
  voiceMinutes    Int        @default(10) @map("voice_minutes")
  quizGenerations Int        @default(5) @map("quiz_generations")
  kbUploads       Int        @default(3) @map("kb_uploads")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  userPlans       UserPlan[]

  @@map("plans")
}

model UserPlan {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  planId    String    @map("plan_id")
  status    String    @default("active")
  startedAt DateTime  @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@map("user_plans")
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  metric    String
  value     Float    @default(1)
  periodKey String   @map("period_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, metric, periodKey])
  @@map("usage_records")
}

model FlaggedConversation {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  flagType  String   @map("flag_type")
  reason    String   @default("")
  flaggedBy String   @map("flagged_by")
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([flagType, resolved])
  @@map("flagged_conversations")
}

model Payment {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  planId            String   @map("plan_id")
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  amount            Int
  currency          String   @default("INR")
  status            String   @default("created")
  periodMonths      Int      @default(1) @map("period_months")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  planId             String   @map("plan_id")
  status             String   @default("active")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model AiCostRecord {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  capability        String
  model             String
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  audioDurationSecs Float    @default(0) @map("audio_duration_secs")
  estimatedCostUsd  Float    @map("estimated_cost_usd")
  periodKey         String   @map("period_key")
  sessionId         String?  @map("session_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, periodKey])
  @@index([periodKey])
  @@index([capability])
  @@map("ai_cost_records")
}

model UserRiskFlag {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  riskType   String   @map("risk_type")
  severity   String
  details    Json     @default("{}")
  status     String   @default("open")
  reviewedBy String?  @map("reviewed_by")
  reviewNote String   @default("") @map("review_note")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, riskType, status])
  @@index([severity, status])
  @@index([riskType, status])
  @@map("user_risk_flags")
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String   @map("ip_address")
  userAgent String   @default("") @map("user_agent")
  country   String?
  city      String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([ipAddress])
  @@map("user_login_events")
}

model AutomationRule {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  enabled     Boolean   @default(true)
  trigger     Json
  actions     Json
  lastRunAt   DateTime? @map("last_run_at")
  runCount    Int       @default(0) @map("run_count")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([enabled])
  @@index([createdAt(sort: Desc)])
  @@map("automation_rules")
}

model AutomationLog {
  id        String   @id @default(cuid())
  ruleId    String   @map("rule_id")
  userId    String?  @map("user_id")
  triggered Boolean  @default(false)
  actions   Json     @default("[]")
  success   Boolean  @default(false)
  error     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ruleId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("automation_logs")
}

model Course {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String             @default("")
  isPublished  Boolean            @default(false) @map("is_published")
  requiredPlan String             @default("free") @map("required_plan")
  sortOrder    Int                @default(0) @map("sort_order")
  createdBy    String             @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  modules      Module[]
  enrollments  CourseEnrollment[]

  @@index([isPublished, sortOrder])
  @@map("courses")
}

model Module {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String           @map("module_id")
  title       String
  slug        String
  content     String           @default("")
  contentType String           @default("markdown") @map("content_type")
  sortOrder   Int              @default(0) @map("sort_order")
  durationMin Int              @default(0) @map("duration_min")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  status      String    @default("active")
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
  @@map("course_enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model TutorPersona {
  id                     String               @id @default(cuid())
  name                   String
  slug                   String               @unique
  description            String               @default("")
  avatarUrl              String               @default("") @map("avatar_url")
  expertiseTags          Json                 @default("[]") @map("expertise_tags")
  voiceModel             String               @default("") @map("voice_model")
  voiceBadge             String               @default("") @map("voice_badge")
  isPublished            Boolean              @default(false) @map("is_published")
  behaviorSettings       Json                 @default("{}") @map("behavior_settings")
  currentPromptVersionId String?              @map("current_prompt_version_id")
  createdBy              String               @map("created_by")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  promptVersions         TutorPromptVersion[]

  @@index([isPublished])
  @@map("tutor_personas")
}

model TutorPromptVersion {
  id            String       @id @default(cuid())
  personaId     String       @map("persona_id")
  versionNumber Int          @map("version_number")
  systemPrompt  String       @map("system_prompt")
  changeNote    String       @default("") @map("change_note")
  createdBy     String       @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  persona       TutorPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, versionNumber])
  @@index([personaId, createdAt(sort: Desc)])
  @@map("tutor_prompt_versions")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String    @default("")
  type      String    @default("info")
  category  String    @default("general")
  read      Boolean   @default(false)
  readAt    DateTime? @map("read_at")
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  htmlBody  String   @map("html_body")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model SupportTicket {
  id         String          @id @default(cuid())
  userId     String          @map("user_id")
  subject    String
  status     String          @default("open")
  priority   String          @default("medium")
  category   String          @default("general")
  assignedTo String?         @map("assigned_to")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  messages   TicketMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, priority])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String        @map("ticket_id")
  authorId   String        @map("author_id")
  authorRole String        @default("user") @map("author_role")
  body       String
  isInternal Boolean       @default(false) @map("is_internal")
  createdAt  DateTime      @default(now()) @map("created_at")
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}
